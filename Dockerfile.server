FROM node:20-alpine AS frontend
WORKDIR /app/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM golang:1.26-alpine AS backend
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=frontend /app/web/dist ./cmd/server/panelassets
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /aura-power-server ./cmd/server/

FROM gcr.io/distroless/static-debian12:nonroot
LABEL org.opencontainers.image.source="https://github.com/weauratech/aura-power"
LABEL org.opencontainers.image.description="Aura Power Server - Kubernetes workload energy governance API and panel"
LABEL org.opencontainers.image.licenses="Apache-2.0"
COPY --from=backend /aura-power-server /aura-power-server
USER 65534:65534
EXPOSE 8080
ENTRYPOINT ["/aura-power-server"]
