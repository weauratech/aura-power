{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "server": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "const": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "auth": {
          "type": "object",
          "properties": {
            "existingSecret": { "type": "string" },
            "jwtSecret": { "type": "string" },
            "accessTokenTTL": { "type": "string", "pattern": "^[1-9][0-9]*(ns|us|µs|ms|s|m|h)$" },
            "refreshTokenTTL": { "type": "string", "pattern": "^[1-9][0-9]*(ns|us|µs|ms|s|m|h)$" }
          }
        }
      }
    },
    "controller": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "leaderElection": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" }, "id": { "type": "string", "minLength": 1 } }
        },
        "config": {
          "type": "object",
          "properties": {
            "argoTrackingLabelKeys": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "replicas": { "minimum": 2 } }, "required": ["replicas"] },
          "then": {
            "properties": {
              "leaderElection": {
                "properties": { "enabled": { "const": true } },
                "required": ["enabled"]
              }
            }
          }
        }
      ]
    },
    "webhook": {
      "type": "object",
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "failurePolicy": { "type": "string", "enum": ["Fail", "Ignore"] },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 30 },
        "existingSecret": { "type": "string" },
        "caBundle": { "type": "string" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "additionalServerEgressPorts": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "uniqueItems": true
        }
      }
    }
  }
}
